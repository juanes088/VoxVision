# Copia este archivo a .env y coloca tus claves. NO subas el .env al repo.

# Motor local
HOST_MOTOR=127.0.0.1
PUERTO_MOTOR=8765
URL_MOTOR=http://127.0.0.1:8765

# Proveedor de vision+conversacion: claude | local
PROVEEDOR_VISION=claude

# Claude via aiapiflow (OpenAI-compatible)
URL_BASE_IA=https://aiapiflow.com/v1
CLAVE_API_IA=coloca_tu_clave_aqui
MODELO_IA=claude-sonnet-5
TIEMPO_ESPERA_IA=45

# Modelos locales (STT Whisper y VLM Qwen 3B)
DISPOSITIVO=cuda
MODELO_QWEN_VL=modelos/qwen2.5-vl-3b
MODELO_WHISPER=small
CUANTIZACION_4BIT=true
TOKEN_HUGGINGFACE=
QWEN_MIN_PIXELS=200704
QWEN_MAX_PIXELS=1003520

# Piper TTS (local)
RUTA_MODELO_PIPER=modelos/piper/es_ES-davefx-medium.onnx
RUTA_EJECUTABLE_PIPER=bin/piper/piper.exe

# Interfaz
INDICE_CAMARA=0
